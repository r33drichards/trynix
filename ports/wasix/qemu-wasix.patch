+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef QEMU_STATFS_WASIX_H
+#define QEMU_STATFS_WASIX_H
+#include <sys/statvfs.h>
+/* WASIX reports statvfs, not Linux statfs. A zero type means unspecified. */
+struct statfs {
+    unsigned long f_type, f_bsize, f_namelen;
+    uint64_t f_blocks, f_bfree, f_bavail, f_files, f_ffree;
+    struct { unsigned int __val[2]; } f_fsid;
+};
+static inline int fstatfs(int fd, struct statfs *out)
+{
+    struct statvfs in;
+    int ret = fstatvfs(fd, &in);
+    if (ret < 0) { return ret; }
+    memset(out, 0, sizeof(*out));
+    out->f_bsize = in.f_frsize ? in.f_frsize : in.f_bsize;
+    if (!out->f_bsize) { errno = EIO; return -1; }
+    out->f_blocks = in.f_blocks; out->f_bfree = in.f_bfree;
+    out->f_bavail = in.f_bavail; out->f_files = in.f_files;
+    out->f_ffree = in.f_ffree; out->f_namelen = in.f_namemax;
+    out->f_fsid.__val[0] = in.f_fsid;
+    return 0;
+}
+#endif
