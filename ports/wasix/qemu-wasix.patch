+    int ret = posix_memalign(&ptr, align, size);
+    if (ret) { errno = ret; return NULL; }
+    memset(ptr, 0, size);
+    if (alignment) { *alignment = align; }
+    trace_qemu_anon_ram_alloc(size, ptr);
+    return ptr;
